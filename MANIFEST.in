include LICENSE README.md CHANGELOG.md CITATION.cff RELEASE_NOTES.md RELEASE_VALIDATION.md requirements.txt requirements-dev.txt Makefile
recursive-include docs *.md
recursive-include examples *.py *.yaml *.csv
recursive-include tests *.py
recursive-include paper *.tex *.pdf
recursive-include monte_carlo_results *.csv
prune build
prune dist
prune .pytest_cache
global-exclude __pycache__ *.py[cod] *.aux *.log *.out *.toc *.xdv *.fls *.fdb_latexmk
