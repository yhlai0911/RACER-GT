# 本機環境
.venv/
*.synctex.gz

# LaTeX build artifacts (sources under docs/latex are tracked on purpose:
# without them the published PDFs cannot be rebuilt or archived by Zenodo)
docs/latex/*.aux
docs/latex/*.log
docs/latex/*.out
docs/latex/*.toc
docs/latex/*.xdv
docs/latex/*.fls
docs/latex/*.fdb_latexmk
docs/latex/*.synctex.gz
docs/latex/*.lof
docs/latex/*.lot
# Compiling inside docs/latex (rather than via scripts/build_docs.py) drops the
# PDF next to its source. The published PDFs live in docs/pdf; the figures are
# inputs and stay tracked.
docs/latex/*.pdf
!docs/latex/figures/*.pdf

# 同儕審查報告及其全部延伸產物（來源 .tex、編譯出的 PDF 與 LaTeX 中間檔）。
# 這是對本專案的外部審查意見，不屬於 RACER-GT 的發布內容，一律不進版控。
/review/

# 真實 GT 資料與其衍生結果。手動下載自 trends.google.com，非本專案發布內容；
# 保留在工作樹中供驗證使用，但不進版控（授權狀態與再散布權利未確認）。
/real_data/

# 真實資料的衍生輸出：診斷表是摘要統計量，可進版控供審查者核對論文表格；
# 逐日重建數列實質上是 GT 數值的轉換，與 /real_data/ 適用同一個再散布考量。
/real_data_validation/graph_series.csv
/real_data_validation/sequential_series.csv
